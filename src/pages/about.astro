---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'About | Network Note';
const pageDescription =
	'Network Noteを運営しているyamaxn1のプロフィールページです。'
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="profile">
				<h1>About</h1>
				<h2>運営者</h2>
				<p>
					ネットワークに関わる仕事に従事しています。<br />
					ネットワーク経験4年。
				</p>

				<h2>保有資格</h2>
				<ul>
					<li>CCNA</li>
					<li>AWS Certified Cloud Practitioner</li>
					<li>TOEIC スコア820</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 860px;
		margin: 0 auto;
		padding: 4em 1em;
	}

	.profile {
		line-height: 1.9;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: 0.5em;
	}

	h2 {
		margin-top: 2.2em;
		font-size: 1.5rem;
	}

	.lead {
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
	}

	ul {
		padding-left: 1.5em;
	}

	a {
		color: rgb(var(--accent));
	}
</style>